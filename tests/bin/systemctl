#!/usr/bin/env python3
"""测试用假 systemctl：只实现 check.py / autofix.py 用到的 show / is-active / restart。
每次调用追加一行到 $FAKE_SYSTEMCTL_LOG（若设置）。"""
import os, sys

UNITS = {   # name: (LoadState, ActiveState, UnitFileState)
    "my-app":      ("loaded",    "active",   "enabled"),
    "capture-svc": ("loaded",    "inactive", "enabled"),
    "embed-proxy": ("loaded",    "failed",   "enabled"),
    "old-svc":     ("loaded",    "inactive", "disabled"),
    "legacy-app":  ("loaded",    "inactive", "enabled"),
}
NOT_FOUND = ("not-found", "inactive", "")

args = sys.argv[1:]
if os.environ.get("FAKE_SYSTEMCTL_LOG"):
    with open(os.environ["FAKE_SYSTEMCTL_LOG"], "a") as f:
        f.write(" ".join(args) + "\n")
user = "--user" in args
args = [a for a in args if a != "--user"]
verb, unit = args[0], args[1]
load, active, ufs = UNITS.get(unit, NOT_FOUND)

if verb == "show":
    print(f"LoadState={load}\nActiveState={active}\nUnitFileState={ufs}")
elif verb == "is-active":
    print(active); sys.exit(0 if active == "active" else 3)
elif verb == "restart":
    sys.exit(0 if load == "loaded" else 5)
else:
    print(f"fake systemctl: 不支持 {verb}", file=sys.stderr); sys.exit(1)
